{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "sarand",
          "informationUri": "https://github.com/msoleimani62/sarand",
          "rules": [
            {
              "id": "todo/todo",
              "shortDescription": {
                "text": "TODO marker found in source"
              }
            },
            {
              "id": "todo/bug",
              "shortDescription": {
                "text": "BUG marker found in source"
              }
            },
            {
              "id": "todo/fixme",
              "shortDescription": {
                "text": "FIXME marker found in source"
              }
            },
            {
              "id": "todo/safety",
              "shortDescription": {
                "text": "SAFETY marker found in source"
              }
            },
            {
              "id": "todo/hack",
              "shortDescription": {
                "text": "HACK marker found in source"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "todo/todo",
